  // pull_out_row.dart
  //
  // PullOutRow — a 3D perspective row where the selected child slides out of
  // the row. YOU design the child; this widget only handles layout, 3D
  // transform, fade/blur, spring motion and input.
  //
  // Single file. Zero dependencies. Flutter 3.10+.
  //
  //   final controller = PullOutController();
  //
  //   SizedBox(
  //     height: 600, // needs bounded height
  //     child: PullOutRow(
  //       controller: controller,
  //       itemCount: items.length,
  //       itemBuilder: (context, i, t) => MyCard(items[i]),
  //       onIndexChanged: (i) => debugPrint('selected $i'),
  //       controlsBuilder: (context, c) => PullOutScrubber(controller: c),
  //     ),
  //   );
  //
  // itemBuilder receives `t`: 1.0 when the item is the selected one (fully
  // pulled out), 0.0 when it is part of the row. Use it to animate your own
  // design (glow, scale, show details...). Pass `t` through or ignore it.
  
  
  
  /// [selected] is 0..1 — how "pulled out" this item is right now.
  typedef PullOutItemBuilder = Widget Function(
      BuildContext context, int index, double selected);
  typedef PullOutSlotBuilder = Widget Function(
      BuildContext context, PullOutController controller);
  
  // ─────────────────────────────────────────────────────────────────────────────
  // Style
  // ─────────────────────────────────────────────────────────────────────────────
  
  /// Sizes are fractions of item height so the row scales to any space.
  @immutable
  class PullOutStyle {
    const PullOutStyle({
      this.itemHeight,
      this.heightFactor = 0.38,
      this.aspectRatio = 1.0,
      this.itemAngle = 0.62,
      this.sceneTilt = 0.44,
      this.perspective = 0.05,
      this.stepX = 0.135,
      this.stepY = -0.012,
      this.stepZ = 0.19,
      this.anchor = 2.3,
      this.pullOut = 0.8,
      this.pullScale = 1.0,
      this.visibleCount = 11,
      this.behindCount = 7,
      this.fadeStart = 0.55,
      this.nearBlur = 0.9,
      this.farBlur = 2.0,
      this.dimFar = 0.35,
    });
  
    /// Item height in px. Null = [heightFactor] of available height.
    final double? itemHeight;
    final double heightFactor;
  
    /// width / height of each item.
    final double aspectRatio;
  
    /// Yaw of each item in radians (0 = facing viewer).
    final double itemAngle;
  
    /// Camera pitch in radians.
    final double sceneTilt;
  
    /// 0 = orthographic, ~0.35 natural, 0.8 dramatic.
    final double perspective;
  
    /// Per-item offset along the row (fraction of item height).
    final double stepX;
    final double stepY;
    final double stepZ;
  
    /// How many items back from the front the row is centred on.
    final double anchor;
  
    /// How far the selected item slides out, as a fraction of item width.
    /// Negative slides the other way. 0 disables.
    final double pullOut;
  
    /// Extra scale on the selected item (1 = none, 1.1 = 10% bigger).
    final double pullScale;
  
    final int visibleCount;
    final int behindCount;
  
    /// Fraction (0..1) of visibleCount where the far fade begins.
    final double fadeStart;
  
    /// Blur sigma per item in front (capped at 8) / for far items.
    final double nearBlur;
    final double farBlur;
  
    /// 0..1 darkening of far items.
    final double dimFar;
  
    PullOutStyle copyWith({
      double? itemHeight,
      double? heightFactor,
      double? aspectRatio,
      double? itemAngle,
      double? sceneTilt,
      double? perspective,
      double? stepX,
      double? stepY,
      double? stepZ,
      double? anchor,
      double? pullOut,
      double? pullScale,
      int? visibleCount,
      int? behindCount,
      double? fadeStart,
      double? nearBlur,
      double? farBlur,
      double? dimFar,
    }) {
      return PullOutStyle(
        itemHeight: itemHeight ?? this.itemHeight,
        heightFactor: heightFactor ?? this.heightFactor,
        aspectRatio: aspectRatio ?? this.aspectRatio,
        itemAngle: itemAngle ?? this.itemAngle,
        sceneTilt: sceneTilt ?? this.sceneTilt,
        perspective: perspective ?? this.perspective,
        stepX: stepX ?? this.stepX,
        stepY: stepY ?? this.stepY,
        stepZ: stepZ ?? this.stepZ,
        anchor: anchor ?? this.anchor,
        pullOut: pullOut ?? this.pullOut,
        pullScale: pullScale ?? this.pullScale,
        visibleCount: visibleCount ?? this.visibleCount,
        behindCount: behindCount ?? this.behindCount,
        fadeStart: fadeStart ?? this.fadeStart,
        nearBlur: nearBlur ?? this.nearBlur,
        farBlur: farBlur ?? this.farBlur,
        dimFar: dimFar ?? this.dimFar,
      );
    }
  }
  
  // ─────────────────────────────────────────────────────────────────────────────
  // Controller
  // ─────────────────────────────────────────────────────────────────────────────
  
  class PullOutController extends ChangeNotifier {
    PullOutController({int initialIndex = 0}) : _index = initialIndex;
  
    _PullOutRowState? _state;
    int _index;
    final ValueNotifier<double> _position = ValueNotifier<double>(0);
  
    int get currentIndex => _index;
  
    /// Fractional scroll position, updates every frame while moving.
    double get position => _position.value;
    ValueListenable<double> get positionListenable => _position;
  
    int get itemCount => _state?.widget.itemCount ?? 0;
    bool get canGoNext => _index < itemCount - 1;
    bool get canGoPrev => _index > 0;
  
    void animateTo(int index) => _state?._goTo(index);
    void jumpTo(int index) => _state?._jump(index.toDouble());
    void next() => _state?._goTo((_state?._target ?? _index) + 1);
    void prev() => _state?._goTo((_state?._target ?? _index) - 1);
  
    /// Set a fractional position immediately (custom scrubbers). Pair with [settle].
    void scrollTo(double position) => _state?._jump(position);
    void settle() => _state?._goTo(_position.value.round());
  
    void _attach(_PullOutRowState s) {
      _state = s;
      _index = s._index;
      _position.value = s._anim.value;
    }
  
    void _detach(_PullOutRowState s) {
      if (_state == s) _state = null;
    }
  
    void _setIndex(int i) {
      _index = i;
      notifyListeners();
    }
  
    @override
    void dispose() {
      _position.dispose();
      super.dispose();
    }
  }
  
