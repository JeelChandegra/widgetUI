  // ─────────────────────────────────────────────────────────────────────────────
  // Image colour extraction (shares Flutter's image cache with the card)
  // ─────────────────────────────────────────────────────────────────────────────
  
  Future<Color?> extractImageColor(String url) async {
    final stream = NetworkImage(url).resolve(ImageConfiguration.empty);
    final done = Completer<ui.Image?>();
    late final ImageStreamListener listener;
    listener = ImageStreamListener(
          (info, _) {
        if (!done.isCompleted) done.complete(info.image.clone());
      },
      onError: (_, __) {
        if (!done.isCompleted) done.complete(null);
      },
    );
    stream.addListener(listener);
    final img = await done.future
        .timeout(const Duration(seconds: 20), onTimeout: () => null);
    stream.removeListener(listener);
    if (img == null) return null;
  
    final data = await img.toByteData(format: ui.ImageByteFormat.rawRgba);
    final w = img.width, h = img.height;
    img.dispose();
    if (data == null) return null;
  
    final total = w * h;
    final stride = (total ~/ 4000).clamp(1, total).toInt();
    double r = 0, g = 0, b = 0, wsum = 0;
    for (var p = 0; p < total; p += stride) {
      final o = p * 4;
      final pr = data.getUint8(o), pg = data.getUint8(o + 1), pb = data.getUint8(o + 2);
      final hsv = HSVColor.fromColor(Color.fromARGB(255, pr, pg, pb));
      if (hsv.value < 0.12) continue;
      final weight = hsv.saturation * hsv.value + 0.03;
      r += pr * weight;
      g += pg * weight;
      b += pb * weight;
      wsum += weight;
    }
    if (wsum == 0) return null;
  
    final hsl = HSLColor.fromColor(
      Color.fromARGB(255, (r / wsum).round(), (g / wsum).round(), (b / wsum).round()),
    );
    return hsl
        .withSaturation(hsl.saturation.clamp(0.4, 0.8).toDouble())
        .withLightness(hsl.lightness.clamp(0.26, 0.40).toDouble())
        .toColor();
  }
  
  // ─────────────────────────────────────────────────────────────────────────────
  // Responsive style (phone first)
  // ─────────────────────────────────────────────────────────────────────────────
  
  
    PullOutStyle responsiveStyle(MediaQueryData mq) {
    const aspect = 0.72;
    const pullOut = 0.95;
    const angle = 0.55;
    const stepX = 0.40;
  
    final w = mq.size.width;
    final compact = w < 600;
    final widthFrac = compact ? 0.56 : (w < 1024 ? 0.34 : 0.24);
  
    // top bar + chips + product header + purchase panel
    final reserved = mq.padding.vertical + (compact ? 360 : 380);
    final sceneH = mq.size.height - reserved;
  
    final h = math
        .min(w * widthFrac / aspect, sceneH * 0.78)
        .clamp(150.0, 640.0)
        .toDouble();
  
    return PullOutStyle(
      itemHeight: h,
      aspectRatio: aspect,
      itemAngle: angle,
      sceneTilt: 0.28,
      perspective: 0.03,
      stepX: stepX,
      stepY: -0.01,
      stepZ: 0.4,
      anchor: pullOut * aspect * math.cos(angle) / stepX,
      pullOut: pullOut,
      pullScale: 1.05,
      visibleCount: 4,
      behindCount: 4,
      fadeStart: 0.1,
      nearBlur: 0.1,
      farBlur: compact ? 1.8 : 2.5,
      dimFar: 0.2,
    );
  }
  
