  class StorePage extends StatefulWidget {
    const StorePage({super.key});
  
    @override
    State<StorePage> createState() => _StorePageState();
  }
  
  class _StorePageState extends State<StorePage> with TickerProviderStateMixin {
    static const _bg = Color(0xFF08090D);
    static const _fallback = Color(0xFF1E2230);
  
    final controller = PullOutController();
    late final AnimationController _intro =
    AnimationController(vsync: this, duration: const Duration(milliseconds: 1300));
  
    final Map<int, Color> colors = {};
    final Set<int> favorites = {};
    final List<CartLine> lines = [];
    final List<_Flight> _flights = [];
  
    final _bagKey = GlobalKey();
    final _addKey = GlobalKey();
  
    String chip = 'All'; // highlighted chip
    String category = 'All'; // applied filter (changes after the fade-out)
    String size = 'M';
    bool rowShown = true;
    int _catToken = 0;
  
    int bagBump = 0;
    int? justAdded;
    int? favBurstId;
    Timer? _addedTimer;
    Timer? _burstTimer;
  
    int get cartCount => lines.fold(0, (a, l) => a + l.qty);
  
    List<Product> get visible => category == 'All'
        ? products
        : products.where((p) => p.category == category).toList();
  
    @override
    void initState() {
      super.initState();
      SystemChrome.setSystemUIOverlayStyle(SystemUiOverlayStyle.light);
      _intro.forward();
      for (final p in products) {
        extractImageColor(p.image).then((c) {
          if (mounted && c != null) setState(() => colors[p.id] = c);
        });
      }
    }
  
    @override
    void dispose() {
      for (final f in _flights) {
        f.entry.remove();
        f.ctrl.dispose();
      }
      _flights.clear();
      _addedTimer?.cancel();
      _burstTimer?.cancel();
      _intro.dispose();
      controller.dispose();
      super.dispose();
    }
  
    // ── colours ───────────────────────────────────────────────────────────────
  
    Color _colorOf(List<Product> list, int i) =>
        colors[list[i.clamp(0, list.length - 1).toInt()].id] ?? _fallback;
  
    Color _blended(List<Product> list, double pos) {
      final lo = pos.floor().clamp(0, list.length - 1).toInt();
      final hi = (lo + 1).clamp(0, list.length - 1).toInt();
      return Color.lerp(_colorOf(list, lo), _colorOf(list, hi), pos - lo)!;
    }
  
    // ── actions ───────────────────────────────────────────────────────────────
  
    Future<void> _setCategory(String c) async {
      if (c == chip) return;
      HapticFeedback.selectionClick();
      final token = ++_catToken;
      setState(() {
        chip = c;
        rowShown = false;
      });
      await Future.delayed(const Duration(milliseconds: 200));
      if (!mounted || token != _catToken) return;
      controller.jumpTo(0);
      setState(() {
        category = c;
        rowShown = true;
      });
    }
  
    void _toggleFav(Product p) {
      HapticFeedback.lightImpact();
      final adding = !favorites.contains(p.id);
      setState(() {
        adding ? favorites.add(p.id) : favorites.remove(p.id);
        favBurstId = adding ? p.id : null;
      });
      _burstTimer?.cancel();
      if (adding) {
        _burstTimer = Timer(const Duration(milliseconds: 700), () {
          if (mounted) setState(() => favBurstId = null);
        });
      }
    }
  
    Offset? _centerOf(GlobalKey k) {
      final box = k.currentContext?.findRenderObject() as RenderBox?;
      if (box == null || !box.attached) return null;
      return box.localToGlobal(box.size.center(Offset.zero));
    }
  
    void _addToCart(Product p) {
      HapticFeedback.mediumImpact();
  
      setState(() => justAdded = p.id);
      _addedTimer?.cancel();
      _addedTimer = Timer(const Duration(milliseconds: 1500), () {
        if (mounted) setState(() => justAdded = null);
      });
  
      final from = _centerOf(_addKey);
      final to = _centerOf(_bagKey);
      if (from == null || to == null) {
        _land(p, size);
        return;
      }
  
      final lockedSize = size;
      final ctrl = AnimationController(
        vsync: this,
        duration: const Duration(milliseconds: 750),
      );
      final control = Offset(
        (from.dx + to.dx) / 2 - 70,
        math.min(from.dy, to.dy) - 160,
      );
  
      late final OverlayEntry entry;
      entry = OverlayEntry(
        builder: (_) => IgnorePointer(
          child: Stack(
            clipBehavior: Clip.none,
            children: [
              AnimatedBuilder(
                animation: ctrl,
                builder: (_, __) {
                  final t = Curves.easeInOutCubic.transform(ctrl.value);
                  final u = 1 - t;
                  final pos = from * (u * u) + control * (2 * u * t) + to * (t * t);
                  final s = ui.lerpDouble(76, 22, t)!;
                  final fade = ctrl.value > 0.88
                      ? (1 - (ctrl.value - 0.88) / 0.12).clamp(0.0, 1.0).toDouble()
                      : 1.0;
                  return Positioned(
                    left: pos.dx - s / 2,
                    top: pos.dy - s / 2,
                    width: s,
                    height: s,
                    child: Opacity(
                      opacity: fade,
                      child: Container(
                        decoration: BoxDecoration(
                          shape: BoxShape.circle,
                          border: Border.all(color: Colors.white, width: 2),
                          boxShadow: [
                            BoxShadow(
                              color: Colors.black.withAlpha(120),
                              blurRadius: 16,
                              offset: const Offset(0, 6),
                            ),
                          ],
                        ),
                        child: ClipOval(
                          child: Image.network(
                            p.image,
                            fit: BoxFit.cover,
                            errorBuilder: (_, __, ___) =>
                            const ColoredBox(color: Color(0xFF3DDC97)),
                          ),
                        ),
                      ),
                    ),
                  );
                },
              ),
            ],
          ),
        ),
      );
  
      Overlay.of(context).insert(entry);
      final flight = _Flight(ctrl, entry);
      _flights.add(flight);
      ctrl.forward().whenComplete(() {
        entry.remove();
        ctrl.dispose();
        _flights.remove(flight);
        if (mounted) _land(p, lockedSize);
      });
    }
  
    void _land(Product p, String s) {
      HapticFeedback.lightImpact();
      setState(() {
        final i = lines.indexWhere((l) => l.product.id == p.id && l.size == s);
        if (i >= 0) {
          lines[i].qty++;
        } else {
          lines.add(CartLine(p, s));
        }
        bagBump++;
      });
    }
  
    void _openCart() {
      HapticFeedback.selectionClick();
      showModalBottomSheet<void>(
        context: context,
        isScrollControlled: true,
        backgroundColor: Colors.transparent,
        barrierColor: Colors.black.withAlpha(150),
        builder: (_) => _CartSheet(
          lines: lines,
          onChanged: () {
            if (mounted) setState(() {});
          },
        ),
      );
    }
  
    // ── build ─────────────────────────────────────────────────────────────────
  
    @override
    Widget build(BuildContext context) {
      final mq = MediaQuery.of(context);
      final style = responsiveStyle(mq);
      final list = visible;
  
      return Scaffold(
        backgroundColor: _bg,
        body: Stack(
          children: [
            // Background follows the product colour
            Positioned.fill(
              child: ValueListenableBuilder<double>(
                valueListenable: controller.positionListenable,
                builder: (_, pos, __) {
                  final c = _blended(list, pos);
                  return DecoratedBox(
                    decoration: BoxDecoration(
                      gradient: LinearGradient(
                        begin: Alignment.topCenter,
                        end: Alignment.bottomCenter,
                        colors: [
                          Color.lerp(c, _bg, 0.1)!,
                          Color.lerp(c, _bg, 0.7)!,
                          _bg,
                        ],
                        stops: const [0, 0.55, 1],
                      ),
                    ),
                    child: DecoratedBox(
                      decoration: BoxDecoration(
                        gradient: RadialGradient(
                          center: const Alignment(0.4, -0.2),
                          radius: 0.9,
                          colors: [Colors.white.withAlpha(26), Colors.transparent],
                        ),
                      ),
                    ),
                  );
                },
              ),
            ),
            SafeArea(
              child: Column(
                children: [
                  _Reveal(
                    anim: _intro,
                    begin: 0,
                    end: 0.45,
                    dy: -16,
                    child: _TopBar(
                      count: cartCount,
                      bump: bagBump,
                      bagKey: _bagKey,
                      onBag: _openCart,
                    ),
                  ),
                  _Reveal(
                    anim: _intro,
                    begin: 0.12,
                    end: 0.55,
                    dy: 14,
                    child: _CategoryChips(selected: chip, onSelect: _setCategory),
                  ),
                  Expanded(
                    child: _Reveal(
                      anim: _intro,
                      begin: 0.25,
                      end: 0.9,
                      dy: 36,
                      scaleFrom: 0.9,
                      child: AnimatedOpacity(
                        opacity: rowShown ? 1 : 0,
                        duration: const Duration(milliseconds: 200),
                        curve: Curves.easeOut,
                        child: AnimatedScale(
                          scale: rowShown ? 1 : 0.96,
                          duration: const Duration(milliseconds: 260),
                          curve: Curves.easeOutCubic,
                          child: PullOutRow(
                            controller: controller,
                            itemCount: list.length,
                            style: style,
                            dragPixelsPerItem: style.stepX * (style.itemHeight ?? 240),
                            autofocus: true,
                            headerBuilder: (context, c) {
                              final p = list[c.currentIndex.clamp(0, list.length - 1).toInt()];
                              return _ProductHeader(product: p);
                            },
                            itemBuilder: (context, i, selected) => ProductCard(
                              product: list[i],
                              selected: selected,
                              glow: colors[list[i].id] ?? _fallback,
                              isFav: favorites.contains(list[i].id),
                              burst: favBurstId == list[i].id,
                              onFav: () => _toggleFav(list[i]),
                            ),
                            controlsBuilder: (context, c) {
                              final p = list[c.currentIndex.clamp(0, list.length - 1).toInt()];
                              return _PurchasePanel(
                                product: p,
                                size: size,
                                addKey: _addKey,
                                onSize: (s) {
                                  HapticFeedback.selectionClick();
                                  setState(() => size = s);
                                },
                                added: justAdded == p.id,
                                onAdd: () => _addToCart(p),
                              );
                            },
                          ),
                        ),
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ],
        ),
      );
    }
  }
  
