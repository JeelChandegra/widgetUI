  class _Dims {
    const _Dims(this.w, this.h);
    final double w;
    final double h;
  
    factory _Dims.from(BoxConstraints c, PullOutStyle s) {
      var h = s.itemHeight ??
          (c.maxHeight.isFinite ? c.maxHeight * s.heightFactor : 240.0);
      var w = h * s.aspectRatio;
      if (c.maxWidth.isFinite) {
        final maxW = c.maxWidth * 0.62;
        if (w > maxW) {
          w = maxW;
          h = w / s.aspectRatio;
        }
      }
      return _Dims(w, h);
    }
  }
  
  class _PullOutRowState extends State<PullOutRow>
      with SingleTickerProviderStateMixin {
    late final AnimationController _anim;
    late PullOutController _ctrl;
    late bool _ownsCtrl;
    final FocusNode _focus = FocusNode(debugLabel: 'PullOutRow');
  
    late int _index;
    int _target = 0;
    double _wheelAccum = 0;
    DateTime _lastWheel = DateTime.fromMillisecondsSinceEpoch(0);
  
    int get _max => math.max(0, widget.itemCount - 1);
  
    @override
    void initState() {
      super.initState();
      _ownsCtrl = widget.controller == null;
      _ctrl = widget.controller ?? PullOutController();
      _index = (widget.initialIndex ?? _ctrl._index).clamp(0, _max).toInt();
      _target = _index;
      _anim = AnimationController.unbounded(vsync: this, value: _index.toDouble())
        ..addListener(_onTick)
        ..addStatusListener(_onStatus);
      _ctrl._attach(this);
    }
  
    @override
    void didUpdateWidget(PullOutRow old) {
      super.didUpdateWidget(old);
      if (old.controller != widget.controller) {
        _ctrl._detach(this);
        if (_ownsCtrl) _ctrl.dispose();
        _ownsCtrl = widget.controller == null;
        _ctrl = widget.controller ?? PullOutController(initialIndex: _index);
        _ctrl._attach(this);
      }
      if (old.itemCount != widget.itemCount && _anim.value > _max) {
        WidgetsBinding.instance.addPostFrameCallback((_) {
          if (mounted && _anim.value > _max) _jump(_max.toDouble());
        });
      }
    }
  
    @override
    void dispose() {
      _ctrl._detach(this);
      if (_ownsCtrl) _ctrl.dispose();
      _anim.dispose();
      _focus.dispose();
      super.dispose();
    }
  
    // ── motion ────────────────────────────────────────────────────────────────
  
    void _onTick() {
      _ctrl._position.value = _anim.value;
      if (widget.itemCount == 0) return;
      final idx = _anim.value.round().clamp(0, _max).toInt();
      if (idx != _index) {
        _index = idx;
        _ctrl._setIndex(idx);
        widget.onIndexChanged?.call(idx);
      }
    }
  
    void _onStatus(AnimationStatus status) {
      if (status == AnimationStatus.completed) {
        final t = _target.toDouble();
        if (_anim.value != t && (_anim.value - t).abs() < 0.02) _anim.value = t;
      }
    }
  
    void _goTo(int i, {double velocity = 0}) {
      if (widget.itemCount == 0) return;
      _target = i.clamp(0, _max).toInt();
      _anim.animateWith(
        SpringSimulation(widget.spring, _anim.value, _target.toDouble(), velocity),
      );
    }
  
    void _jump(double v) {
      _anim.stop();
      final p = v.clamp(0, _max).toDouble();
      _target = p.round();
      _anim.value = p;
    }
  
    void _tap(int i) {
      widget.onItemTap?.call(i);
      if (i != _index) _goTo(i);
    }
  
    // ── input ─────────────────────────────────────────────────────────────────
  
    void _dragStart(DragStartDetails _) => _anim.stop();
  
    void _dragUpdate(DragUpdateDetails d) {
      var delta = -d.delta.dx / widget.dragPixelsPerItem;
      final v = _anim.value;
      if ((v < 0 && delta < 0) || (v > _max && delta > 0)) delta *= 0.35;
      _anim.value = v + delta;
    }
  
    void _dragEnd(DragEndDetails d) {
      final v = -d.velocity.pixelsPerSecond.dx / widget.dragPixelsPerItem;
      _goTo((_anim.value + v * 0.15).round(), velocity: v);
    }
  
    void _dragCancel() => _goTo(_anim.value.round());
  
    void _onSignal(PointerSignalEvent e) {
      if (!widget.enableWheel || e is! PointerScrollEvent) return;
      GestureBinding.instance.pointerSignalResolver.register(e, (event) {
        final se = event as PointerScrollEvent;
        final now = DateTime.now();
        if (now.difference(_lastWheel) > const Duration(milliseconds: 250)) {
          _wheelAccum = 0;
        }
        _lastWheel = now;
        final dx = se.scrollDelta.dx, dy = se.scrollDelta.dy;
        _wheelAccum += dx.abs() > dy.abs() ? dx : dy;
        if (_wheelAccum.abs() >= widget.wheelThreshold) {
          _goTo(_target + (_wheelAccum > 0 ? 1 : -1));
          _wheelAccum = 0;
        }
      });
    }
  
    KeyEventResult _onKey(FocusNode node, KeyEvent e) {
      if (!widget.enableKeyboard || e is KeyUpEvent) return KeyEventResult.ignored;
      final k = e.logicalKey;
      if (k == LogicalKeyboardKey.arrowRight || k == LogicalKeyboardKey.arrowDown) {
        _goTo(_target + 1);
        return KeyEventResult.handled;
      }
      if (k == LogicalKeyboardKey.arrowLeft || k == LogicalKeyboardKey.arrowUp) {
        _goTo(_target - 1);
        return KeyEventResult.handled;
      }
      if (k == LogicalKeyboardKey.home) {
        _goTo(0);
        return KeyEventResult.handled;
      }
      if (k == LogicalKeyboardKey.end) {
        _goTo(_max);
        return KeyEventResult.handled;
      }
      return KeyEventResult.ignored;
    }
  
    // ── build ─────────────────────────────────────────────────────────────────
  
    @override
    Widget build(BuildContext context) {
      Widget scene = LayoutBuilder(builder: (context, c) {
        final dims = _Dims.from(c, widget.style);
        return AnimatedBuilder(
          animation: _anim,
          builder: (context, _) => _buildScene(context, dims),
        );
      });
  
      if (widget.enableDrag) {
        scene = GestureDetector(
          behavior: HitTestBehavior.opaque,
          onHorizontalDragStart: _dragStart,
          onHorizontalDragUpdate: _dragUpdate,
          onHorizontalDragEnd: _dragEnd,
          onHorizontalDragCancel: _dragCancel,
          child: scene,
        );
      }
      scene = ClipRect(clipBehavior: widget.clipBehavior, child: scene);
  
      return Focus(
        focusNode: _focus,
        autofocus: widget.autofocus,
        onKeyEvent: _onKey,
        child: Listener(
          onPointerDown: (_) => _focus.requestFocus(),
          onPointerSignal: _onSignal,
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              if (widget.headerBuilder != null)
                ListenableBuilder(
                  listenable: _ctrl,
                  builder: (c, _) => widget.headerBuilder!(c, _ctrl),
                ),
              Expanded(child: scene),
              if (widget.controlsBuilder != null)
                ListenableBuilder(
                  listenable: _ctrl,
                  builder: (c, _) => widget.controlsBuilder!(c, _ctrl),
                ),
            ],
          ),
        ),
      );
    }
  
    Widget _buildScene(BuildContext context, _Dims dm) {
      if (widget.itemCount == 0) return const SizedBox.expand();
      final s = widget.style;
      final pos = _anim.value;
      final first = math.max(0, (pos - s.behindCount - 1).floor());
      final last = math.min(widget.itemCount - 1, (pos + s.visibleCount).ceil());
  
      final items = <Widget>[];
      // Far first, near last → correct painter order.
      for (var i = last; i >= first; i--) {
        final d = i - pos;
        if (d <= -s.behindCount || d >= s.visibleCount) continue;
        final item = _buildItem(context, i, d, dm);
        if (item != null) items.add(item);
      }
      return Stack(
        alignment: Alignment.center,
        clipBehavior: Clip.none,
        children: items,
      );
    }
  
    Widget? _buildItem(BuildContext context, int i, double d, _Dims dm) {
      final s = widget.style;
  
      // Opacity
      double opacity;
      if (d >= 0) {
        final f = d / s.visibleCount;
        opacity = f <= s.fadeStart ? 1 : 1 - (f - s.fadeStart) / (1 - s.fadeStart);
      } else {
        opacity = 1 - (-d / s.behindCount) * 0.85;
      }
      opacity = opacity.clamp(0.0, 1.0);
      if (opacity < 0.01) return null;
  
      // Blur
      final sigma = d >= 0
          ? s.farBlur * (d / s.visibleCount)
          : math.min(s.nearBlur * -d, 8.0);
  
      final dim = d > 0 ? (d / s.visibleCount * s.dimFar).clamp(0.0, 1.0) : 0.0;
  
      // 0..1, smoothstep of closeness to the front.
      final p = (1 - d.abs()).clamp(0.0, 1.0).toDouble();
      final selected = p * p * (3 - 2 * p);
  
      Widget child = SizedBox(
        width: dm.w,
        height: dm.h,
        child: widget.itemBuilder(context, i, selected),
      );
  
      if (dim > 0.01) {
        child = ColorFiltered(
          colorFilter: ColorFilter.mode(
            Color.fromRGBO(0, 0, 0, dim),
            BlendMode.srcATop,
          ),
          child: child,
        );
      }
  
      child = GestureDetector(
        behavior: HitTestBehavior.translucent,
        onTap: () => _tap(i),
        child: child,
      );
  
      Widget item = Transform(
        alignment: Alignment.center,
        transform: _itemMatrix(d, selected, dm),
        child: child,
      );
  
      if (sigma > 0.25) {
        item = ImageFiltered(
          imageFilter: ImageFilter.blur(
            sigmaX: sigma,
            sigmaY: sigma,
            tileMode: TileMode.decal,
          ),
          child: item,
        );
      }
      if (opacity < 0.995) item = Opacity(opacity: opacity, child: item);
      if (d > 3) item = IgnorePointer(child: item);
      // Stable identity so each item's own state (animations, images) follows
      // its index while others enter/leave the visible window.
      return KeyedSubtree(key: ValueKey<int>(i), child: item);
    }
  
    Matrix4 _itemMatrix(double d, double selected, _Dims dm) {
      final s = widget.style;
      final focal = dm.h / math.max(s.perspective, 0.0001);
      final z = math.max(d * s.stepZ * dm.h, -focal * 0.55);
      final off = d - s.anchor;
      final pull = selected * s.pullOut * dm.w;
      final scale = 1 + (s.pullScale - 1) * selected;
  
      return Matrix4.identity()
        ..setEntry(3, 2, s.perspective / dm.h)
        ..rotateX(s.sceneTilt)
        ..multiply(Matrix4.translationValues(
          off * s.stepX * dm.h,
          off * s.stepY * dm.h,
          z,
        ))
        ..rotateY(s.itemAngle)
        ..multiply(Matrix4.translationValues(pull, 0, 0))
        ..scale(scale, scale, 1);
    }
  }
  
