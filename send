  /// Waveform-style tick scrubber. Drag to scroll the row, tap to jump.
  class PullOutScrubber extends StatelessWidget {
    const PullOutScrubber({
      super.key,
      required this.controller,
      this.height = 44,
      this.tickSpacing = 6,
      this.color = const Color(0x55FFFFFF),
      this.activeColor = Colors.white,
    });
  
    final PullOutController controller;
    final double height;
    final double tickSpacing;
    final Color color;
    final Color activeColor;
  
    @override
    Widget build(BuildContext context) {
      return LayoutBuilder(builder: (context, c) {
        final w = c.maxWidth;
        double toPos(double x) =>
            (x / w).clamp(0.0, 1.0) * math.max(0, controller.itemCount - 1);
        return GestureDetector(
          behavior: HitTestBehavior.opaque,
          onTapDown: (d) => controller.animateTo(toPos(d.localPosition.dx).round()),
          onHorizontalDragStart: (d) => controller.scrollTo(toPos(d.localPosition.dx)),
          onHorizontalDragUpdate: (d) => controller.scrollTo(toPos(d.localPosition.dx)),
          onHorizontalDragEnd: (_) => controller.settle(),
          onHorizontalDragCancel: controller.settle,
          child: ValueListenableBuilder<double>(
            valueListenable: controller.positionListenable,
            builder: (context, pos, _) => CustomPaint(
              size: Size(w, height),
              painter: _ScrubberPainter(
                position: pos,
                count: controller.itemCount,
                spacing: tickSpacing,
                color: color,
                activeColor: activeColor,
              ),
            ),
          ),
        );
      });
    }
  }
  
  class _ScrubberPainter extends CustomPainter {
    _ScrubberPainter({
      required this.position,
      required this.count,
      required this.spacing,
      required this.color,
      required this.activeColor,
    });
  
    final double position;
    final int count;
    final double spacing;
    final Color color;
    final Color activeColor;
  
    @override
    void paint(Canvas canvas, Size size) {
      final n = math.max(2, (size.width / spacing).floor());
      final m = count <= 1 ? 0.0 : position / (count - 1) * size.width;
      final p = Paint()
        ..strokeCap = StrokeCap.round
        ..strokeWidth = 1.4;
  
      for (var k = 0; k < n; k++) {
        final x = (k + 0.5) * size.width / n;
        final dist = (x - m).abs() / (size.width * 0.14);
        final bump = math.exp(-dist * dist);
        final h = size.height * (0.22 + 0.55 * bump);
        p.color = Color.lerp(color, activeColor, bump)!;
        canvas.drawLine(Offset(x, size.height - h), Offset(x, size.height), p);
      }
  
      p
        ..color = activeColor
        ..strokeWidth = 2;
      canvas.drawLine(Offset(m, 5), Offset(m, size.height), p);
      canvas.drawCircle(Offset(m, 4), 3.5, Paint()..color = activeColor);
    }
  
    @override
    bool shouldRepaint(_ScrubberPainter o) =>
        o.position != position ||
            o.count != count ||
            o.spacing != spacing ||
            o.color != color ||
            o.activeColor != activeColor;
  }
