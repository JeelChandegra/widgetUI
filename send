  // // jewel_case_row.dart
  // //
  // // JewelCaseRow — a 3D perspective row of jewel cases for Flutter.
  // // Single file. Zero dependencies. Flutter 3.10+.
  // //
  // // Quick start:
  // //
  // //   final controller = JewelCaseController();
  // //
  // //   SizedBox(
  // //     height: 600, // needs bounded height
  // //     child: JewelCaseRow(
  // //       controller: controller,
  // //       itemCount: movies.length,
  // //       coverBuilder: (context, i) => Image.asset(movies[i].poster, fit: BoxFit.cover),
  // //       spineLabelBuilder: (i) => movies[i].title,
  // //       spineSubLabelBuilder: (i) => '${movies[i].year}',
  // //       onIndexChanged: (i) => debugPrint('selected $i'),
  // //       controlsBuilder: (context, c) => JewelCaseScrubber(controller: c),
  // //     ),
  // //   );
  // //
  // // Input: horizontal drag (with fling + spring snap), mouse wheel / trackpad,
  // // arrow keys, tap a case to bring it to front.
  // //
  // // Defaults are tuned to the "shelf" look: near-orthographic projection, cases
  // // yawed ~35°, the selected case slid out of the row along its own width.
  // // Everything is in [JewelCaseStyle]; use copyWith to tweak.
  //
  //
